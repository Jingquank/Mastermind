{
  "name": "mastermind-md",
  "version": "0.2.1",
  "type": "module",
  "description": "Review Markdown with your coding agent — local-first, CriticMarkup review loop, bilingual, the file is the protocol",
  "license": "MIT",
  "author": "Kevin Ding <kevincentding@gmail.com>",
  "homepage": "https://github.com/Jingquank/Mastermind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jingquank/Mastermind.git"
  },
  "bugs": {
    "url": "https://github.com/Jingquank/Mastermind/issues"
  },
  "keywords": [
    "markdown",
    "review",
    "criticmarkup",
    "ai-agents",
    "claude",
    "cli",
    "bilingual",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mastermind": "bin/mastermind.js",
    "mastermind-md": "bin/mastermind.js"
  },
  "files": [
    "dist/",
    "bin/",
    "themes/",
    ".claude/skills/",
    "assets/agent/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && tsup",
    "dev": "concurrently -k \"MASTERMIND_PORT=5199 tsx watch src/server/index.ts\" \"vite\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@hono/node-server": "^2.0.4",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-icons": "^1.3.2",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "hono": "^4.12.25",
    "mdast-util-to-markdown": "^2.1.2",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "slot-text": "^0.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
