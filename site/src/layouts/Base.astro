---
import '../styles/tokens.css'
import '../styles/grid.css'
import '../styles/fonts.css'
import '../styles/base.css'
import '../styles/components.css'
import { wordmark } from '../data/hero'
import { repoUrl } from '../data/skills'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'Mastermind — review Markdown with your coding agent',
  description = 'A local-first Markdown reviewer for AI coding agents. CriticMarkup review loop, bilingual, the file is the protocol.',
} = Astro.props
const cols = Array.from({ length: 12 })
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/SchibstedGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // no-flash language: apply the stored language before first paint
      try {
        if (localStorage.getItem('mm-lang') === 'zh') {
          document.documentElement.setAttribute('data-lang', 'zh')
          document.documentElement.lang = 'zh-Hans'
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- press-G grid overlay (shares the .wrap content box) -->
    <div class="grid-overlay" aria-hidden="true">
      <div class="wrap"><div class="cols">{cols.map(() => <i></i>)}</div></div>
    </div>
    <div class="grid-readout" aria-hidden="true">12 cols · 8px baseline · press G</div>

    <!-- 00 · app-chrome -->
    <header class="chrome">
      <div class="wrap chrome-in">
        <div class="chrome-file"><span class="dirty"></span> mastermind.md</div>
        <div class="chrome-right">
          <div class="lang-seg" role="radiogroup" aria-label="Reading language">
            <button data-lang-btn="en" role="radio" aria-checked="true" tabindex="0">EN</button>
            <button data-lang-btn="zh" role="radio" aria-checked="false" tabindex="-1">中文</button>
          </div>
          <button class="cta sm" data-install>Install</button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <!-- 08 · footer -->
    <footer class="footer">
      <div class="wrap footer-row">
        <pre class="masthead" aria-hidden="true">{wordmark}</pre>
        <div class="note-aside">
          <a href={repoUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
          &nbsp;·&nbsp; MIT &nbsp;·&nbsp; the file is the protocol.
        </div>
      </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      const root = document.documentElement
      // EN ⇄ 中文 toggle — text swap is pure CSS; JS flips the attribute + html lang + persists.
      function setLang(l: string) {
        if (l === 'zh') {
          root.setAttribute('data-lang', 'zh')
          root.lang = 'zh-Hans'
        } else {
          root.removeAttribute('data-lang')
          root.lang = 'en'
        }
        try {
          localStorage.setItem('mm-lang', l)
        } catch {}
        document.querySelectorAll('[data-lang-btn]').forEach((b) => {
          const on = b.getAttribute('data-lang-btn') === l
          b.setAttribute('aria-checked', String(on))
          b.setAttribute('tabindex', on ? '0' : '-1') // roving tabindex for the radio group
        })
      }
      let initial = 'en'
      try {
        if (localStorage.getItem('mm-lang') === 'zh') initial = 'zh'
      } catch {}
      setLang(initial)
      // the segmented control owns aria-checked; data-set-lang buttons just trigger a switch
      document
        .querySelectorAll('[data-lang-btn]')
        .forEach((b) => b.addEventListener('click', () => setLang(b.getAttribute('data-lang-btn') || 'en')))
      document
        .querySelectorAll('[data-set-lang]')
        .forEach((b) => b.addEventListener('click', () => setLang(b.getAttribute('data-set-lang') || 'en')))
      // radio-group keyboard pattern (APG): arrows/Home/End move selection + focus together
      const langBtns = Array.from(document.querySelectorAll<HTMLElement>('[data-lang-btn]'))
      document.querySelector('.lang-seg')?.addEventListener('keydown', (e) => {
        const i = langBtns.indexOf(document.activeElement as HTMLElement)
        let n = -1
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % langBtns.length
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + langBtns.length) % langBtns.length
        else if (e.key === 'Home') n = 0
        else if (e.key === 'End') n = langBtns.length - 1
        if (n < 0) return
        e.preventDefault()
        setLang(langBtns[n].getAttribute('data-lang-btn') || 'en')
        langBtns[n].focus()
      })

      // press-G grid overlay — a sighted/keyboard easter egg; the overlay is decorative
      // (aria-hidden), and so is its toggle button, so there's no AT state to sync
      const toggleGrid = () => document.body.classList.toggle('grid-on')
      document.addEventListener('keydown', (e) => {
        const tag = ((e.target as HTMLElement)?.tagName || '').toLowerCase()
        if ((e.key === 'g' || e.key === 'G') && !e.metaKey && !e.ctrlKey && !e.altKey && tag !== 'input' && tag !== 'textarea')
          toggleGrid()
      })
      document.querySelectorAll('[data-grid-toggle]').forEach((b) => b.addEventListener('click', toggleGrid))

      // Install: copy the npm command + toast + smooth-scroll to §07
      const toast = document.getElementById('toast')
      let tT: number
      function showToast(msg: string) {
        if (!toast) return
        toast.textContent = msg
        toast.classList.add('show')
        clearTimeout(tT)
        tT = window.setTimeout(() => toast.classList.remove('show'), 1900)
      }
      // copy + toast only — no scroll-jump (the hero terminal is the visible payoff)
      document.querySelectorAll('[data-install]').forEach((b) =>
        b.addEventListener('click', async () => {
          const cmd = 'npm i -g mastermind-md'
          let ok = false
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(cmd)
              ok = true
            }
          } catch {}
          // never claim success if the write failed — just surface the command
          showToast(ok ? 'Copied  ›  ' + cmd : cmd)
        }),
      )
    </script>
  </body>
</html>
